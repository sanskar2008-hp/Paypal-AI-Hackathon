# GEMINI_API_KEY: Required for Gemini 3.8 Flash AI with Google Search Grounding.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PAYPAL SANDBOX CREDENTIALS:
# Required for live PayPal Sandbox Orders API verification.
# When not provided, PayPilot runs in transparent Sandbox Test Mode.
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"
PAYPAL_CURRENCY="USD"
PAYPAL_ENVIRONMENT="sandbox"

# CHANNEL3 DISCOVERY API (Optional sponsor integration)
CHANNEL3_API_KEY="YOUR_CHANNEL3_API_KEY"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"
